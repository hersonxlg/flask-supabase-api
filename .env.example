# URL base de tu proyecto en Supabase (Project Settings -> API)
SUPABASE_URL="https://tu-project-ref.supabase.co"

# Clave pública 'anon' de Supabase (Project Settings -> API)
# ¡IMPORTANTE: No pongas tu clave real aquí, esto es solo una plantilla!
SUPABASE_KEY="tu_clave_anon_publica_aqui"

# Puerto en el que correrá el servidor web (Opcional, por defecto es 5000)
PORT=5000
